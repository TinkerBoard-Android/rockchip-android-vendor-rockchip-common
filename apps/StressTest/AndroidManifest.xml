    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <uses-permission android:name="android.permission.MOUNT_UNMOUNT_FILESYSTEMS" />

    <uses-sdk
        android:minSdkVersion="11"
        android:targetSdkVersion="23" />

    <protected-broadcast android:name="com.rockchip.sleep.ACTION_TEST_CASE_SLEEP" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:persistent="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="com.cghs.stresstest.StressTestActivity"
            android:label="@string/app_name">
            <!--intent-filter>
               <action android:name="android.intent.action.MAIN" />
		<category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter-->
            <intent-filter>
                <action android:name="android.rk.intent.action.startStressTest" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name="com.cghs.stresstest.test.receiver.MountReceiver">
            <intent-filter android:priority="1000">
                <!--action android:name="android.intent.action.BOOT_COMPLETED" /-->
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- reboot test -->
        <activity
            android:name=".test.RebootTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>

        <receiver android:name="com.cghs.stresstest.test.receiver.RebootReceiver">
            <intent-filter android:priority="1000">   <!-- 2147483647 -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- reboot test end -->


        <!-- sleep test -->
        <activity
            android:name=".test.SleepTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>
        <!--
             <receiver android:name=".SleepTestReceiver" >
            <intent-filter>
                <action android:name="com.rockchip.sleep.ACTION_TEST_CASE_SLEEP" />
            </intent-filter>
        </receiver>
        -->
        <!-- sleep test end -->


        <!-- camera test -->
        <activity android:name=".test.CameraTest" />
        <activity android:name=".test.CameraAutoTestActivity" />

        <service android:name=".test.CameraOpenService"></service>

        <service android:name=".test.service.CameraTestService">
            <intent-filter android:priority="1000"></intent-filter>
        </service>
        <!-- camera test end -->


        <!-- video test -->
        <activity android:name=".test.VideoTest" />
        <activity android:name=".test.VideoPlayActivity" />

        <service android:name=".test.service.VideoTestService">
            <intent-filter android:priority="1000"></intent-filter>
        </service>

        <!-- wifi test -->
        <activity
            android:name=".test.WifiOpenTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>

        <!-- data test -->
        <activity
            android:name=".test.DataOpenTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape" />

        <!-- bt test -->
        <activity
            android:name=".test.BluetoothOpenTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>

        <!-- fly mode test -->
        <activity
            android:name=".test.FlyModeOpenTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>
        <activity
            android:name=".test.SmsSendTest"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"></activity>
    <!--<activity
            android:name=".test.CallNumTest"
            android:screenOrientation="landscape"></activity>
    <activity android:name=".log.LogSetting"></activity>-->

        <service android:name=".log.LogService"></service>

        <!-- recovery test -->
        <activity
            android:name=".test.RecoveryTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape"/>

        <!-- dvfs test -->
        <activity
            android:name=".test.DvfsTest"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|screenLayout"
            android:screenOrientation="landscape" />

        <receiver android:name="com.cghs.stresstest.test.receiver.RecoveryReceiver">
            <intent-filter android:priority="1000">
                <!--action android:name="android.intent.action.BOOT_COMPLETED" /-->
                <action android:name="android.intent.action.MEDIA_MOUNTED" />
                <data android:scheme="file" />
            </intent-filter>
        </receiver>

        <!-- arm frep test -->

        <activity android:name="com.cghs.stresstest.test.ArmFreqTest"></activity>

        <service android:name="com.cghs.stresstest.test.service.ArmFreqTestService">
