cc_prebuilt_library {
    name: "libmpp",
    compile_multilib: "both",
    multilib: {
        lib64: {
            srcs: ["arm64/libmpp.so"],
        },
        lib32: {
            srcs: ["arm/libmpp.so"],
        },
    },
    strip: {
        none: true,
    },
    check_elf_files: false,
    vendor_available: true,
}
